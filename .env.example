# One-time LOCAL Docker Compose configuration. Copy to .env and set secrets.
# Do not commit .env or use these development accounts in production.
# Existing PostgreSQL volumes retain their ORIGINAL password on restart.
DB_PASSWORD=chairx_dev_password

# Mandatory: use distinct strong passwords (12+ chars for employees).
CHAIRX_CATALOG_PASSWORD=
CHAIRX_BOOTSTRAP_ADMIN_PASSWORD=
CHAIRX_DEV_MANAGER_PASSWORD=
CHAIRX_DEV_EMPLOYEE_PASSWORD=

